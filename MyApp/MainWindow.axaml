<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="600"
        x:Class="MyApp.MainWindow"
        Title="Website Accessibility Tester">

    <ScrollViewer>
        <StackPanel
            Margin="30"
            Spacing="20">

            <TextBlock
                Text="Website Accessibility Tester"
                FontSize="32"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Test how well a website conforms to accessibility standards"
                FontSize="20"
                HorizontalAlignment="Center"/>

            <TextBox
                x:Name="WebsiteUrlTextBox"
                Width="350"
                HorizontalAlignment="Center"
                PlaceholderText="Enter Website URL"/>

            <CheckBox
                x:Name="ShowDetailsCheckBox"
                Content="Developer Mode"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Is there any part of the website that needs to be excluded from testing?"
                IsVisible="{Binding #ShowDetailsCheckBox.IsChecked}"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Please enter the element ID or class name of the element to be excluded:"
                IsVisible="{Binding #ShowDetailsCheckBox.IsChecked}"
                HorizontalAlignment="Center"/>

            <TextBox
                Width="350"
                PlaceholderText="Separate multiple IDs or class names with commas"
                IsVisible="{Binding #ShowDetailsCheckBox.IsChecked}"
                HorizontalAlignment="Center"/>

            <Button
                x:Name="RunButton"
                Content="Run"
                Width="150"
                Height="50"
                HorizontalAlignment="Center"
                Click="RunButton_Click"/>

            <!-- Error message -->
            <TextBlock
                x:Name="ErrorTextBlock"
                Foreground="Red"
                TextWrapping="Wrap"
                IsVisible="False"
                HorizontalAlignment="Center"/>

            <!-- Report -->
            <!-- Report -->
<Border
    x:Name="ReportPanel"
    Background="White"
    BorderBrush="#D9DEE5"
    BorderThickness="1"
    CornerRadius="10"
    Padding="25"
    IsVisible="False">

    <StackPanel 
        Spacing="15">

        <!-- Report Header -->
        <StackPanel Spacing="5">

            <TextBlock
                Text="Accessibility Report"
                FontSize="26"
                FontWeight="Bold"/>

            <TextBlock
                x:Name="WebsiteTextBlock"
                Foreground="#666666"/>

        </StackPanel>


        <!-- Score -->
        <Border
            Background="#000000"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

            <StackPanel Spacing="5">

                <TextBlock
                    Text="Overall Accessibility Score"
                    FontSize="14"
                    Foreground="#666666"/>

                <TextBlock
                    x:Name="ScoreTextBlock"
                    FontSize="22"
                    FontWeight="Bold"/>

            </StackPanel>

        </Border>


        <!-- Keyboard Accessibility -->
        <Border
            Background="#000000"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

            <StackPanel Spacing="7">

                <TextBlock
                    Text="Keyboard Accessibility"
                    FontSize="20"
                    FontWeight="Bold"/>

                <TextBlock
                    x:Name="KeyboardSummaryTextBlock"
                    FontSize="16"/>

                <StackPanel
                    x:Name="KeyboardIssuesPanel"
                    Spacing="5"/>

            </StackPanel>

        </Border>


        <!-- Alternative Text -->
        <Border
            Background="#000000"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

            <StackPanel Spacing="7">

                <TextBlock
                    Text="Alternative Text"
                    FontSize="20"
                    FontWeight="Bold"/>

                <TextBlock
                    x:Name="AltTextTextBlock"
                    FontSize="16"/>

            </StackPanel>

        </Border>


        <!-- Responsive Design -->
        <Border
            Background="#000000"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

            <StackPanel Spacing="7">

                <TextBlock
                    Text="Responsive Design"
                    FontSize="20"
                    FontWeight="Bold"/>

                <TextBlock
                    x:Name="ResponsiveSummaryTextBlock"
                    FontSize="16"/>

                <StackPanel
                    x:Name="ResponsiveIssuesPanel"
                    Spacing="5"/>

            </StackPanel>

        </Border>


        <!-- Colour Contrast -->
        <Border
            Background="#000000"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

            <StackPanel Spacing="10">

                <TextBlock
                    Text="Colour Contrast"
                    FontSize="20"
                    FontWeight="Bold"/>

                <TextBlock
                    x:Name="ContrastSummaryTextBlock"
                    FontSize="16"/>


                <ScrollViewer
                    MaxHeight="300">

                    <StackPanel
                        x:Name="ContrastFailuresPanel"
                        Spacing="10"/>

                </ScrollViewer>

            </StackPanel>

        </Border>

    </StackPanel>

</Border>

        </StackPanel>
    </ScrollViewer>

</Window>